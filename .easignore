# Same exclusions as .gitignore, plus editor/agent tooling that EAS Build
# should never need to see. .easignore replaces .gitignore entirely for EAS
# (they aren't merged), so everything from .gitignore is repeated here.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Editor/agent tooling — not needed in the build, and .claude/skills/*
# contains real symlinks that EAS's tarball step can't recreate on Windows.
.claude/
.agents/
